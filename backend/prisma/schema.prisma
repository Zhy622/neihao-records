generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  WORK
  STUDY
  RELATIONSHIP
  CONSUMPTION
  CHOICE
  EMOTION
  OTHER
}

enum Emotion {
  ANXIETY
  OVERTHINKING
  FEAR
  GRIEVANCE
  ANGER
  AVOIDANCE
  BLANK
}

enum TimeCost {
  WITHIN_5_MINUTES
  WITHIN_30_MINUTES
  WITHIN_1_HOUR
  HALF_DAY
  OVER_1_DAY
}

enum WorthIt {
  WORTH_IT
  NOT_WORTH_IT
  UNCLEAR
}

enum RecordSyncStatus {
  ACTIVE
  DELETED
}

enum PeopleObservationEmotion {
  CONTEMPT
  INFERIORITY
  JEALOUSY
  DEFIANT
  ENVY
  ADMIRATION
  OTHER
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  displayName        String?
  signature          String              @default("")
  avatarData         Bytes?
  avatarMimeType     String?
  records            Record[]
  peopleObservations PeopleObservation[]
  notes              Note[]
  refreshTokens      RefreshToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  aiInsights         AiInsight[]
  aiJobs             AiJob[]

  @@map("users")
}

model Record {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String?
  title              String
  category           Category
  emotions           Emotion[]
  emotionIntensity   Int
  decisionDifficulty Int
  timeCost           TimeCost
  thoughts           String           @default("")
  finalDecision      String           @default("")
  worthIt            WorthIt
  syncStatus         RecordSyncStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  aiInsights         AiInsight[]
  aiJobs             AiJob[]

  @@index([userId, createdAt])
  @@index([userId, category])
  @@unique([userId, clientId])
  @@map("records")
}

model PeopleObservation {
  id                       String                     @id @default(uuid())
  userId                   String
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId                 String?
  alias                    String
  emotions                 PeopleObservationEmotion[]
  triggerScene             String                     @default("")
  contemptPoints           String                     @default("")
  inferiorityOrEnvyPoints  String                     @default("")
  otherStrengths           String                     @default("")
  myStrengths              String                     @default("")
  personDefinition         String                     @default("")
  learningAction           String                     @default("")
  syncStatus               RecordSyncStatus           @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?

  @@index([userId, createdAt])
  @@unique([userId, clientId])
  @@map("people_observations")
}

model Note {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String?
  content    String
  noteType   String
  emotions   String[]
  categories String[]
  syncStatus RecordSyncStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  @@index([userId, createdAt])
  @@unique([userId, clientId])
  @@map("notes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AiInsight {
  id            String   @id @default(uuid())
  userId        String
  recordId      String?
  type          String
  provider      String
  model         String
  promptVersion String
  resultJson    Json
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  record        Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([recordId])
  @@map("ai_insights")
}

enum AiJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model AiJob {
  id            String      @id @default(uuid())
  userId        String
  recordId      String?
  type          String
  status        AiJobStatus @default(PENDING)
  provider      String
  model         String
  promptVersion String
  resultJson    Json?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  record        Record?     @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([recordId])
  @@map("ai_jobs")
}
